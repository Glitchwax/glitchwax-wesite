{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glitchwax-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Only ./public is uploaded (2026-09-13, audit A-39). Everything the
    // deploy must never publish — src/, wrangler.jsonc, .dev.vars, .env,
    // docs, .git — now lives OUTSIDE the assets directory, so a new repo
    // file can no longer be served by accident. public/.assetsignore is a
    // second line of defence for anything copied in here by mistake.
    "directory": "./public",
    // Without a binding, env.ASSETS was undefined and every unknown URL
    // answered "error 1101" instead of 404 (pre-existing). With assets
    // configured, matching requests are served BEFORE the Worker runs, so
    // page views never reached the logging / ?ref= cookie code either.
    // run_worker_first routes everything through the Worker, which then
    // serves the asset via env.ASSETS.fetch.
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SQUARE_ENVIRONMENT": "production",
    "SQUARE_LOCATION_ID": "LPA9XDRHBBB1Q",
    "CONTACT_FROM_EMAIL": "contact@glitchwax.com",
    "CONTACT_TO_EMAIL": "glitchwax.main@gmail.com",
    "SHIPPING_FEE_CENTS": "595",
    "SUPABASE_URL": "https://sjawcftheiebuwqskois.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_mEO1df2hZL4pSr8CHI5vVg_DE5peI71"
  },
  // Per-IP rate limits (audit A-12). These are Cloudflare's built-in Rate
  // Limiting bindings: the namespace ids are just numbers this Worker picks,
  // there is nothing to create in the dashboard first. The Worker treats a
  // missing binding as "no limit", so removing this block only turns the
  // limits off — it never breaks checkout or the forms.
  //
  // Limits are per IP, per route, counted at the edge location handling the
  // request (eventually consistent), so treat them as spam brakes, not
  // guarantees. Form routes: 4 posts a minute. Checkout: 15 a minute,
  // deliberately generous because phone carriers and school wifi put many
  // real skaters behind one IP.
  "ratelimits": [
    {
      "name": "RL_FORMS",
      "namespace_id": "1001",
      "simple": {
        "limit": 4,
        "period": 60
      }
    },
    {
      "name": "RL_CHECKOUT",
      "namespace_id": "1002",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "glitchwax.main@gmail.com"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}