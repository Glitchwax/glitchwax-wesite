{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glitchwax-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // Without a binding, env.ASSETS was undefined and every unknown URL
    // answered "error 1101" instead of 404 (pre-existing). With assets
    // configured, matching requests are served BEFORE the Worker runs, so
    // page views never reached the logging / ?ref= cookie code either.
    // run_worker_first routes everything through the Worker, which then
    // serves the asset via env.ASSETS.fetch.
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "SQUARE_ENVIRONMENT": "production",
    "SQUARE_LOCATION_ID": "LPA9XDRHBBB1Q",
    "CONTACT_FROM_EMAIL": "contact@glitchwax.com",
    "CONTACT_TO_EMAIL": "glitchwax.main@gmail.com",
    "SHIPPING_FEE_CENTS": "595",
    "SUPABASE_URL": "https://sjawcftheiebuwqskois.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_mEO1df2hZL4pSr8CHI5vVg_DE5peI71"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "glitchwax.main@gmail.com"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}